{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "esModuleInterop": true
  },
  "exclude": [
    "**/.template",
    "**/tmp",
    "**/temp",
    "**/lib",
    "**/dist",
    "**/build",
    "**/public",
    "**/scripts",
    "**/.scripts",
    "**/coverage",
    "**/node_modules",
    "**/__fixtures__",
    "**/__snapshots__"
  ],
  "include": [
    "**/src/**/*.d.ts",
    "**/src/**/*.test.ts",
    "**/src/**/*.test.tsx"
  ]
}
