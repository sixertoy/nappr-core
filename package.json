{
  "name": "@nappr/nappr-core",
  "version": "0.3.0",
  "description": "Nappr JS Core Library",
  "type": "module",
  "main": "./dist/nappr-core.cjs",
  "module": "./dist/nappr-core.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/nappr-core.js",
      "require": "./dist/nappr-core.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=v22.15"
  },
  "dependencies": {
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@nappr/eslint-config": "^0.2.0",
    "@eslint/js": "^9.17.0",
    "@types/lodash": "^4.17.20",
    "@types/node": "^25.0.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "@vitest/coverage-v8": "4.0.16",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^16.5.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vite": "^7.3.0",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^4.0.16"
  },
  "scripts": {
    "test": "vitest --coverage",
    "lint": "eslint . && tsc --noEmit",
    "lint:fix": "eslint . --fix",
    "type:check": "tsc --noEmit",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "docs": "docsify serve docs --port=2999",
    "dev": "vite build --watch",
    "prebuild": "rm -rf dist",
    "build": "vite build",
    "prepare": "yarn run build"
  }
}
